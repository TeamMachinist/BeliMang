# K3s Local Development Environment Configuration
# Copy this file to .env and update the values according to your environment

# Application Environment
ENV=development
GIN_MODE=debug
HTTP_PORT=8080

# Database Configuration
DB_HOST=postgres-service
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=dev-password-123
DB_NAME=belimang
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:dev-password-123@postgres-service:5432/belimang?sslmode=disable

# Cache Configuration
CACHE_HOST=redis-service
CACHE_PORT=6379
CACHE_PASSWORD=
CACHE_DB=0
REDIS_ADDR=redis-service:6379

# Logger Configuration
LOG_LEVEL=debug
LOG_TYPE=simple

# JWT Configuration
JWT_SECRET_KEY=dev-jwt-secret-key-for-local-development-only
JWT_ISSUER=belimang-app

# Go Runtime Configuration (Local Development)
GOMAXPROCS=4
GOMEMLIMIT=1536MiB
GODEBUG=asyncpreemptoff=1
GOCACHE=/tmp/go-cache
GOTMPDIR=/tmp/go-tmp

# K3s Specific Configuration
K3S_NODE_IP=127.0.0.1
K3S_CLUSTER_CIDR=10.42.0.0/16
K3S_SERVICE_CIDR=10.43.0.0/16

# Storage Configuration (Local Development)
POSTGRES_STORAGE_SIZE=2Gi
REDIS_STORAGE_SIZE=1Gi
STORAGE_CLASS=local-path

# Resource Limits (Local Development)
POSTGRES_CPU_LIMIT=1
POSTGRES_MEMORY_LIMIT=1Gi
POSTGRES_CPU_REQUEST=500m
POSTGRES_MEMORY_REQUEST=256Mi

REDIS_CPU_LIMIT=500m
REDIS_MEMORY_LIMIT=512Mi
REDIS_CPU_REQUEST=250m
REDIS_MEMORY_REQUEST=128Mi

APP_CPU_LIMIT=1
APP_MEMORY_LIMIT=1Gi
APP_CPU_REQUEST=1
APP_MEMORY_REQUEST=256Mi
APP_REPLICAS=1