# Kubernetes Production Environment Configuration
# Copy this file to .env and update the values according to your environment

# Application Environment
ENV=production
GIN_MODE=release
HTTP_PORT=8080

# Database Configuration
DB_HOST=postgres-service
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-this-secure-password-production
DB_NAME=belimang
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:change-this-secure-password-production@postgres-service:5432/belimang?sslmode=disable

# Cache Configuration
CACHE_HOST=redis-service
CACHE_PORT=6379
CACHE_PASSWORD=
CACHE_DB=0
REDIS_ADDR=redis-service:6379

# Logger Configuration
LOG_LEVEL=info
LOG_TYPE=json

# JWT Configuration
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production-use-long-random-string-minimum-32-chars
JWT_ISSUER=belimang-app

# Go Runtime Configuration (Production: 7 Core, 21GB RAM)
GOMAXPROCS=6
GOMEMLIMIT=3584MiB
GODEBUG=asyncpreemptoff=1
GOCACHE=/tmp/go-cache
GOTMPDIR=/tmp/go-tmp

# Docker Registry Configuration (for K8s deployment)
REGISTRY=docker.io
REGISTRY_USER=your-dockerhub-username
IMAGE_TAG=latest

# Storage Configuration (Production)
POSTGRES_STORAGE_SIZE=50Gi
REDIS_STORAGE_SIZE=20Gi
STORAGE_CLASS=fast-ssd

# Resource Limits (Production: 7 Core, 21GB RAM)
POSTGRES_CPU_LIMIT=4
POSTGRES_MEMORY_LIMIT=12Gi
POSTGRES_CPU_REQUEST=2
POSTGRES_MEMORY_REQUEST=4Gi

REDIS_CPU_LIMIT=2
REDIS_MEMORY_LIMIT=6Gi
REDIS_CPU_REQUEST=1
REDIS_MEMORY_REQUEST=2Gi

APP_CPU_LIMIT=3
APP_MEMORY_LIMIT=4Gi
APP_CPU_REQUEST=2
APP_MEMORY_REQUEST=1Gi
APP_REPLICAS=2