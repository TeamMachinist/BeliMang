# Belimang Application Environment Configuration
# Copy this file to .env and update the values according to your environment

# Application Environment
ENV=development
GIN_MODE=debug
HTTP_PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-secure-password-here
DB_NAME=belimang
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:your-secure-password-here@localhost:5432/belimang?sslmode=disable

# Cache Configuration
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASSWORD=
CACHE_DB=0
REDIS_ADDR=redis:6379

# Logger Configuration
LOG_LEVEL=info
LOG_TYPE=simple

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-use-long-random-string
JWT_ISSUER=belimang-app

# Go Runtime Configuration
GOMAXPROCS=4
GOMEMLIMIT=1536MiB
GODEBUG=asyncpreemptoff=1
GOCACHE=/tmp/go-cache
GOTMPDIR=/tmp/go-tmp